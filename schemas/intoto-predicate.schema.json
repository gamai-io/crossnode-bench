{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamai.io/crossnode-bench/schemas/intoto-predicate.schema.json",
  "title": "in-toto statement predicate for a CrossNode evidence artifact",
  "type": "object",
  "required": ["_type", "subject", "predicateType", "predicate"],
  "properties": {
    "_type": {"const": "https://in-toto.io/Statement/v1"},
    "subject": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "digest"],
        "properties": {
          "name": {"type": "string"},
          "digest": {
            "type": "object",
            "required": ["sha256"],
            "properties": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
          }
        }
      }
    },
    "predicateType": {"const": "https://gamai.io/crossnode-bench/predicate/v1"},
    "predicate": {
      "type": "object",
      "required": ["records", "merkle_root", "source_sha256", "tool"],
      "properties": {
        "records": {"type": "integer", "minimum": 0},
        "merkle_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "tool": {"type": "string"},
        "spec": {"type": "string"},
        "build": {"type": "object"}
      }
    }
  }
}
